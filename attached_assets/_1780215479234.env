# ====================================================================
# STEP 09: LENSFLOW API CREDENTIALS & SERVICE CONFIGURATION
# ====================================================================

# 1. CORE SCRAPER ARCHITECTURE (Step 01 & 02)
# Get this key from your Apify Console (https://apify.com)
APIFY_API_TOKEN=apify_api_your_secret_token_here

# 2. AI SCRIPT GENERATION ENGINE (Step 04)
# Get this key from your OpenAI Developer Dashboard (https://platform.openai.com)
OPENAI_API_KEY=sk-proj-yourOpenAiSecretKeyHere

# 3. VOICE RENDERING ENGINE (Step 05)
# Get this key from your ElevenLabs Profile Settings (https://elevenlabs.io)
ELEVENLABS_API_KEY=el-secret-yourElevenLabsKeyHere
MIA_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# 4. DIGITAL PRESENTATION ENGINE (Step 06)
# Get this key from your HeyGen Space Settings (https://heygen.com/api)
HEYGEN_API_KEY=your_heygen_v2_api_key_here
MIA_AVATAR_ID=Mia_RealEstate_9:16

# 5. VIDEO ASSEMBLY COMPOSER (Step 07)
# Get this key from your Shotstack Dashboard (https://shotstack.io)
SHOTSTACK_API_KEY=your_shotstack_stage_or_prod_key_here

# 6. INFRASTRUCTURE & EVENT BUS (Step 08)
# Generated automatically when you initialize your backend service on Inngest
INNGEST_EVENT_KEY=ink_your_inngest_production_event_key