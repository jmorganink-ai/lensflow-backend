modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["hubspot:1.0.0", "stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 18224
externalPort = 5000

[[ports]]
localPort = 20161
externalPort = 3000

[[ports]]
localPort = 23780
externalPort = 3001

[[ports]]
localPort = 25401
externalPort = 3003

[[ports]]
localPort = 25402
externalPort = 4200

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-dfdae97e-a094-4e9a-8807-6cead5534551"

[userenv]

[userenv.shared]
HEYGEN_AVATAR_MIA = "e3b75de02e304bbeacabf1a8d7eba959"
HEYGEN_AVATAR_OLIVER = "072d3a64f1884dedaaca04d6ac6e7be7"
HEYGEN_AVATAR_JAMES = "426df1e119054477a2188b41dbca60cf"
HEYGEN_AVATAR_SOPHIE = "b1a01a6df4e141d7ab71999b95403455"
